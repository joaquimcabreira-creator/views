CREATE TABLE CLIENTE(
  ID INT AUTO_INCREMENT PRIMARY KEY,
  NOME_COMPLETO  VARCHAR(255) NOT NULL,
  CIDADE VARCHAR(255) NOT NULL,
  ESTADO CHAR(2) NOT NULL
);

